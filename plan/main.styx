name hfst

source {
    url "git@github.com:hfst/hfst"
    ref master
}

children (
    {
        id scaffold
        title "Cargo workspace + crate skeletons, nfst path deps, Rust nplan platform, manifest re-scope"
        priority 0
        log (
            {
                at 2026-06-24T16:34:38.219695Z
                author "brendan@necessary.nu"
                kind @status
                text "Todo → Doing (nplan_start)"
            }

            {
                at 2026-06-24T17:12:44.389107Z
                author "brendan@necessary.nu"
                kind @status
                text "Doing → Done (nplan_complete)"
            }
        )
    }

    {
        id types
        title "Port hfst-types (data types, exceptions, symbol defs, string utils)"
        priority 6
        deps (scaffold idiom2)
        log (
            {
                at 2026-06-28T12:12:44.174434Z
                author "brendan@necessary.nu"
                kind @decision
                text "Repurposed to Stage 3 (post-idiomatization): the original per-crate breakdown (types/core/openfst/ol/facade/parsers/capi) is now the work of reviewing the monolithic hfst crate and splitting it back into coherent layered crates. Bumped P0/P1/P2 -> P6/P7/P8 and gated `types` on `idiom2` so the decomposition runs after Wave 4 Stage 1 (memory-safety) and Stage 2 (de-C-ism / drop libc). Per nplan_decisions [dec:hfst:idiomatize-staging]."
            }
        )
    }

    {
        id core
        title "Port hfst-core (tokenizer, flag diacritics, HfstBasicTransducer, transition graph, convert)"
        priority 6
        deps (types)
        children (
            {
                id core.util
                title "string-conversions, tokenizer, flag diacritics, epsilon handler, harmonize"
                priority 6
                deps (types)
            }

            {
                id core.basic
                title "transition data/graph + HfstBasicTransducer (the interchange format)"
                priority 6
                deps (core.util)
            }

            {
                id core.convert
                title "ConvertTransducerFormat (HfstBasicTransducer ↔ backend interchange)"
                priority 6
                deps (core.basic)
            }
        )
    }

    {
        id openfst
        title "Reimplement used OpenFST subset (hfst-openfst): VectorFst, semirings, algorithms, SymbolTable, binary I/O"
        priority 6
        deps (types)
        children (
            {
                id openfst.containers
                title "VectorFst, Transition, tropical/log semirings, SymbolTable, state/transition iterators"
                priority 6
                deps (types)
            }

            {
                id openfst.algo
                title "compose/determinize/minimize/shortest-path/push/encode/rm-eps/equivalent + basic ops"
                priority 6
                deps (openfst.containers)
            }

            {
                id openfst.io
                title "OpenFST binary FST read/write + header"
                priority 6
                deps (openfst.containers)
            }
        )
    }

    {
        id ol
        title "Port hfst-ol (optimized-lookup + HfstOlTransducer + ConvertOl)"
        priority 7
        deps (types core)
    }

    {
        id facade
        title "Port hfst facade (HfstTransducer, I/O streams, Tropical/Log wrappers, compose_intersect, rules, print/extract)"
        priority 7
        deps (core openfst ol)
        children (
            {
                id facade.transducer
                title "HfstTransducer class (backend-dispatching facade)"
                priority 7
                deps (core openfst)
            }

            {
                id facade.weight
                title "Tropical/LogWeightTransducer + Convert* over hfst-openfst"
                priority 7
                deps (openfst core)
            }

            {
                id facade.compose-intersect
                title "compose_intersect/* (optimized composition engine over HfstBasicTransducer)"
                priority 7
                deps (core)
            }

            {
                id facade.io
                title "HfstInputStream / HfstOutputStream (format detection + binary I/O)"
                priority 7
                deps (facade.transducer)
            }

            {
                id facade.rules
                title "HfstRules, HfstXeroxRules, HfstApply"
                priority 7
                deps (facade.transducer)
            }

            {
                id facade.print
                title "PrintDot, PrintPCKimmo, ExtractStrings, Strings2FstTokenizer"
                priority 7
                deps (facade.transducer)
            }
        )
    }

    {
        id parsers
        title "Port hfst-parsers (XRE/LEXC/PMATCH/TWOLC/XFST evaluators over nfst + AT&T I/O)"
        priority 8
        deps (facade)
        children (
            {
                id parsers.xre
                title "XRE evaluator (nfst-xre AST → transducer; xre_utils, XreCompiler semantics)"
                priority 8
                deps (facade)
            }

            {
                id parsers.lexc
                title "LEXC evaluator (nfst-lexc AST → transducer; lexc-utils, LexcCompiler semantics)"
                priority 8
                deps (facade)
            }

            {
                id parsers.pmatch
                title "PMATCH evaluator (nfst-pmatch AST → transducer; pmatch_utils, PmatchCompiler semantics)"
                priority 8
                deps (facade)
            }

            {
                id parsers.twolc
                title "TWOLC evaluator (nfst-twolc AST → rules → transducers; rule_src/variable_src semantics)"
                priority 8
                deps (facade)
            }

            {
                id parsers.xfst
                title "XFST evaluator (nfst-xfst AST → command/stack dispatch; xfst-utils, XfstCompiler semantics)"
                priority 8
                deps (facade)
            }

            {
                id parsers.att
                title "AT&T format reader/writer (not covered by nfst)"
                priority 8
                deps (facade)
            }
        )
    }

    {
        id capi
        title "Port hfst-c (C API via cbindgen)"
        priority 8
        deps (facade)
    }

    {
        id literal-port
        title "Literal 1:1 bug-for-bug port of all of libhfst/src into the hfst crate (progress tracked by port_check/manifest, not sub-nodes)"
        priority 0
        deps (scaffold)
        log (
            {
                at 2026-06-24T17:19:59.6827Z
                author "brendan@necessary.nu"
                kind @status
                text "Todo → Doing (nplan_start)"
            }

            {
                at 2026-06-28T12:00:14.477746Z
                author "brendan@necessary.nu"
                kind @status
                text "Doing → Done (nplan_complete)"
            }
        )
    }

    {
        id idiom1
        title "Wave 4 Stage 1 — make the hfst library memory-safe (union→enum, raw-ptr→Box, no static mut); no naming/structural change beyond what safety requires"
        priority 4
        deps (literal-port)
        children (
            {
                id idiom1.backend-enum
                title "TransducerImplementation union → enum; fold discriminant into get_type(); rewrite the 207 dispatch sites + Drop/assign/convert/apply; hfst_transducer.rs + weight-transducer raw pointers → Box/owned"
                priority 4
                deps (literal-port)
                log (
                    {
                        at 2026-06-28T12:16:23.674271Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan_start)"
                    }

                    {
                        at 2026-06-28T13:19:21.255103Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Phase 2 (locals cleanup) done. hfst_transducer.rs unsafe 125->51. Eliminated: union->enum (e08cab91); the entire HfstBasicTransducer conversion machinery (get_basic_transducer/convert_to_basic_transducer now return owned, convert_to_hfst_transducer takes owned) clearing every *mut HfstBasicTransducer local (net/internal/this_basic/another_basic/substituting_net); harmonize_ -> Option<HfstTransducer>; another_/another_copy/tr_harmonized/harmonized_lexicon -> owned; all op-method into_raw/from_raw round-trips; weight-transducer extract_paths fd param *mut FdTable -> Option<&FdTable> (both Tropical+Log); two as_bytes_mut flag-rewrites -> format!. Rippled 6 CLI call sites + 2 hfst print modules to the owned signatures (mechanical, not CLI idiomatization). 110 tests green.\n\nRemaining unsafe in hfst_transducer.rs roots in OTHER nodes' producers, not backend-enum's to convert: (a) XreCompiler::compile() -> *mut [get_flag_filter/new_filter/length_tr/worsener] = idiom1.parsers; (b) read_lexc_ptr/convert_static public *mut-returning APIs = later; (c) the OL lookup const-cast island (as_hfst_ol_ptr, IDIOM-STAGE-2); (d) Stage-2 C-isms (FILE*/libc/2x static mut shuffle_*).\n\nDECISION: #![deny(unsafe_code)] deferred. Crate/file-wide deny is premature — pmatch(238 raw ptr)/parsers/core are uncleaned sibling nodes, so it would need a large allow-list. Intended end-state gate: add it once the allow-list is empty, i.e. at close of idiom1 or as the Stage-2 drop-libc gate."
                    }

                    {
                        at 2026-06-28T13:20:51.755641Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan_complete)"
                    }
                )
            }

            {
                id idiom1.pmatch
                title "pmatch_compiler.rs: 49 static mut → safe + 238 raw-ptr → Box/owned (largest single cluster)"
                priority 4
                deps (idiom1.backend-enum)
                log (
                    {
                        at 2026-06-28T14:41:39.672Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan_start)"
                    }

                    {
                        at 2026-06-28T14:54:39.671317Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Approach: user chose \"expand tests, then full convert\". Step 1 (test net) DONE. Added tests/test_pmatch.rs: 8 tests covering union/concat/optional/predefined-acceptors(*,+)/definition-reference(DAG)/deep-multilevel-DAG(test.pmatch french streets)/EndTag-runtime-match/Numeral-runtime-match. Baselined green on the raw-pointer code. Note: compile() only returns TOP in the result map (intermediate defs referenced internally), so tests assert on TOP only.\n\nSurvey findings (Explore agent) driving the conversion:\n- AST is a DAG not a tree: symbol_from_global_context returns the SAME *mut dyn PmatchObject stored in DEFINITIONS, also referenced from expression trees + CALL_STACK. -> safe repr = Rc<RefCell<dyn PmatchObject>> (NOT Box). Rc<RefCell<dyn T>> IS constructible via unsize coercion through RefCell/UnsafeCell.\n- Current code LEAKS (157 into_raw vs 82 from_raw; init_globals clears maps without freeing) -> no free discipline to preserve; Rc is strictly better.\n- 49 static mut: scalar flags (verbose/flatten/format/len/timer/counters), C-string buffers (data/startptr *mut c_char via libc::strdup, never freed), 3 AST-pointer collections (DEFINITIONS/DEF_INSED_EXPRESSIONS/CALL_STACK), ~12 plain collections, utils:*mut PmatchUtilityTransducers. Accessor pattern: `fn definitions() -> &'static mut BTreeMap<..>` via addr_of_mut!. Rc is !Send so globals MUST become thread_local! (not Mutex) -> &'static mut accessors must move to closure-based with_borrow_mut at ~50+ sites.\n- Single-threaded. RefCell re-entrancy hazard: a self-referential (recursive) pmatch definition would panic (double borrow) where raw ptr just recursed -- not covered by tests; acceptable, note it.\n- compile() -> HashMap<String, *mut HfstTransducer> (result transducers, caller-owned). PmatchTransducerContainer wraps *mut HfstTransducer as a PmatchObject. evaluate(&mut self) -> *mut HfstTransducer is the hot trait method (22 impls).\n\nNext: full thread_local + Rc<RefCell> conversion (subagent-driven, gated by build + 8 test_pmatch + 2 smokes + 121 suite)."
                    }
                )
            }

            {
                id idiom1.parsers
                title "xfst_compiler / xre / lexc / twolc evaluators: raw-ptr → owned + their static mut → safe"
                priority 4
                deps (idiom1.backend-enum)
                log (
                    {
                        at 2026-06-28T13:21:54.146459Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan_start)"
                    }

                    {
                        at 2026-06-28T13:36:42.896204Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Slice 1 (xre loop-closer) done. XreCompiler::compile / compile_first now return Option<HfstTransducer> instead of *mut (compile_impl already returned Option). All workspace callers updated: xre.rs intra (define/get_positions/Regex), keystone hfst_transducer.rs (get_flag_filter->Option, new_filter->owned, eliminate_flag(s) if-let, length_tr/worsener owned -- these were the residuals deferred from backend-enum, now CLOSED), lexc.rs xre usage (2 sites), pmatch_compiler.rs (1 bridge -> *mut, pmatch is idiom1.pmatch), xfst_compiler.rs (contains_regexps/contains_regexp_markers_on_one_side -> owned returns, is_well_formed brackets owned, cr caller owned; 3 bridges back to *mut where they feed the xfst stack_/definitions_/latest_regex_compiled raw graph = this node's Task 12), CLI hfst-regexp2fst (2 loops -> if-let/let-else) + hfst-grep, examples xre_smoke + xre_readfile_smoke.\n\nUnsafe: xre.rs 5->2 (remaining 2 = fopen/fclose Stage-2 C-ism), hfst_transducer.rs 51->32, lexc.rs 3->1, xfst_compiler.rs 171->160. 110 tests green.\n\nRemaining in node: Task 11 lexc.rs (LexcCompiler::compile + read_lexc_ptr still *mut; twolc.rs 2 into/from_raw); Task 12 xfst_compiler.rs stack_/definitions_/top()/define_transducer raw-pointer graph (55 *mut) + 1 static mut -- removes the 3 bridges added here."
                    }

                    {
                        at 2026-06-28T13:43:38.093405Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Slice 2 (lexc + twolc) done = Task 11. LexcCompiler::compile + compile_lexical and TwolcCompiler::compile now return Option<HfstTransducer> instead of *mut. lexc.rs and twolc.rs are now FULLY free of raw owning pointers (0 into_raw/from_raw/*mut HfstTransducer each); lexc.rs's only remaining unsafe is libc::isatty (Stage-2 C-ism). Callers updated: hfst_transducer.rs read_lexc_ptr arm bridged back to *mut (read_lexc_ptr is a facade *mut API -> idiom1.core), xfst read_lexc_from_file -> let-else + stack bridge (Task 12), CLI hfst-lexc-compiler let-else, test_lexc + lexc_smoke + twolc_smoke. 110 tests green.\n\nNode remaining: Task 12 only -- xfst_compiler.rs stack_/definitions_/top()/define_transducer raw-pointer graph (~55 *mut, 160 unsafe) + 1 static mut (HAS_LEXC_BEEN_READ_). Completing Task 12 removes the bridges added in slices 1+2 (latest_regex_compiled, define, substituted, read_lexc_from_file stack push)."
                    }

                    {
                        at 2026-06-28T14:37:26.378462Z
                        author "brendan@necessary.nu"
                        kind @note
                        text "Slice 3 (xfst stack/definitions graph) done = Task 12. NODE COMPLETE. Converted the entire xfst raw-pointer graph to NetRef = Rc<RefCell<HfstTransducer>>: stack_/names_/definitions_/latest_regex_compiled fields, top()/compile_spanned_xre/define_transducer/convert_to_common_format/add_loaded_definition/get_stack signatures, and all ~180 deref sites. Pointer identity (print_name vs names_) preserved via Rc::ptr_eq; name_net registers the actual stack-top Rc. static mut HAS_LEXC_BEEN_READ_ -> AtomicBool. The slice-1/2 bridges (latest_regex_compiled, define, read_lexc_from_file stack push) are now removed/native.\n\nResult: xfst_compiler.rs *mut HfstTransducer 44->0, static mut 1->0, unsafe 150->25 (all 25 are C-isms/irreducible externals: hfst_fopen/libc::{fclose,system,glob}, HfstInputStream, lookup *mut HfstOneLevelPaths results, att-reader Box::leak recovery, the *mut XreCompiler closure workaround).\n\nSafety net: added tests/test_xfst.rs (3 tests: regex+union stack, name+print_name IDENTITY path, define+reference) -- baselined green on raw-ptr code BEFORE conversion, still green after. Full: cargo nextest -p hfst = 113 passed (110 + 3 xfst) / 14 skipped; xfst_smoke runs; workspace+examples build.\n\nTwo faithful deviations (documented in commit): define_xre null path now skips define+original_definitions_ insert instead of define_transducer(NULL) (avoids null-deref UB); att-reader recovers its Box::leak'd &mut via from_mut. Binary-op operands borrowed as distinct cells (push deep-copies definitions via new_copy -> stack entries pairwise-distinct; only name_net shares a cell, never a binary-op operand).\n\nCross-node bridges still standing (correctly): hfst_transducer.rs read_lexc_ptr (facade *mut API -> idiom1.core); pmatch_compiler.rs read_lexc_ptr/xre.compile (idiom1.pmatch)."
                    }

                    {
                        at 2026-06-28T14:38:04.130403Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan_complete)"
                    }
                )
            }

            {
                id idiom1.core
                title "Remaining library — input_stream/PushbackReader, convert_*, ol, print, generate/guessify: raw-ptr → Box + static mut → safe"
                priority 4
                deps (idiom1.backend-enum)
            }
        )
    }

    {
        id idiom2
        title "Wave 4 Stage 2 — remove all C-isms; drop the libc crate dependency"
        priority 5
        deps (idiom1)
        children (
            {
                id idiom2.io
                title "FILE* I/O → std::io (Read/Write/BufReader/BufWriter); getc/fputc/fopen/fclose → Rust reads; printf/fprintf → write!; clock → std::time (att writers, print_dot/pckimmo)"
                priority 5
                deps (idiom1)
            }

            {
                id idiom2.cstr
                title "c_char/c_int/c_void buffers & signatures → core::ffi; libc str*/mem* → slice/str ops; keep CString/CStr at the FFI boundary"
                priority 5
                deps (idiom1)
            }

            {
                id idiom2.cli
                title "hfst-cli (988 libc sites): extern __std*p statics → std::io::std{in,out,err}(); FILE*/char I/O → std::io; subsumes the CLI extern-FILE* static mut deferred from Stage 1; residual plain static mut → safe"
                priority 5
                deps (idiom2.io idiom2.cstr)
            }

            {
                id idiom2.drop-libc
                title "Remove libc from hfst/hfst-cli/hfst-c Cargo.toml; hfst-c keeps core::ffi types only; workspace builds + tests green with zero libc dep (the closing gate)"
                priority 5
                deps (idiom2.io idiom2.cstr idiom2.cli)
            }
        )
    }
)
