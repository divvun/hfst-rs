                id idiom1.pmatch
                title "pmatch_compiler.rs: 49 static mut → safe + 238 raw-ptr → Box/owned (largest single cluster)"
                priority 4
                deps (idiom1.backend-enum)
                log (
                    {
                        at 2026-06-28T14:41:39.672Z
