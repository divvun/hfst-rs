platforms (
    // The binding is tested through Python, against the extension maturin
    // builds into python/.venv, as pip would install it. The tests read the
    // npm package's fixtures, which node js/test/fixtures.mjs builds, so the
    // fixture builders are inputs too. The type check runs mypy in its own
    // uvx environment: a uv sync there would uninstall the editable build.
    // A check's command is not run by a shell, so python/check.sh holds the
    // steps.
    {
        platform "python"
        files (crates/hfst-python/** crates/hfst-embed/** python/pyproject.toml python/COPYING python/COPYING.LESSER python/check.sh python/divvun_hfst/** python/tests/** js/test/*fixtures.mjs)
        checks {
            test {
                cmd "python/check.sh test"
            }
            typecheck {
                cmd "python/check.sh typecheck"
            }
        }
    }

    // The Swift package is tested through Swift, against the XCFramework
    // swift/build.sh --host builds for the host, as an app links it. The
    // tests read the npm package's fixtures, which node js/test/fixtures.mjs
    // builds, so the fixture builders are inputs too. A check's command is
    // not run by a shell, so swift/check.sh holds the steps.
    {
        platform "swift"
        files (crates/hfst-swift/** crates/hfst-swift-runtime/** crates/hfst-swift-compile/** crates/hfst-embed/** swift/Package.swift swift/build.sh swift/check.sh swift/link-probe/src/** swift/link-probe/Cargo.toml swift/link-probe/Cargo.lock swift/link-probe/uniffi.toml swift/Sources/HFST/** swift/Sources/HFSTCompile/** swift/Tests/** js/test/*fixtures.mjs)
        checks {
            test {
                cmd "swift/check.sh"
            }
        }
    }

    {
        platform "rust"
        files (crates/**/*.rs)
        checks {
            format {
                cmd "cargo fmt --check"
                fix "cargo fmt"
            }
        }
    }

    // The globs stop short of js/hfst/pkg and js/hfst/dist, which hold build
    // output. deno check needs no build: js/deno.json stands a hand-declared
    // module in for the generated glue. js/check.sh holds the step, for the
    // same reason as python/check.sh.
    {
        platform "typescript"
        files (js/check.sh js/hfst/*.ts js/test/**/*.ts)
        checks {
            typecheck {
                cmd "js/check.sh"
            }
        }
    }
)

quality {
    // A pyo3 extension module cannot link a Rust test binary: the interpreter
    // supplies its Python symbols. python/tests tests it, under the python
    // platform's checks, and no Rust ratio can count those tests. The package
    // it builds into, python/divvun_hfst, is tested by the same pytest suite
    // in python/tests, which a directory-scoped ratio cannot see; tests
    // beside it would ship in the wheel. The Swift package's UniFFI glue is
    // tested the same way, through Swift in swift/Tests against the
    // XCFramework swift/build.sh makes, which no Rust ratio can count. So is
    // swift/link-probe, the second library of the Swift linking test.
    exempt-paths ("crates/hfst-python/**" "python/divvun_hfst/**" "crates/hfst-swift/**" "crates/hfst-swift-runtime/**" "crates/hfst-swift-compile/**" "swift/link-probe/**")
}

commit {
    type-prefix "required"
}

adoption {
    scope "porting"
}
