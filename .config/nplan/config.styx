platforms (
    {
        platform "c++"
        files (src/**/*.c src/**/*.cc src/**/*.cpp src/**/*.cxx src/**/*.h src/**/*.hpp include/**/*.h include/**/*.hpp)
        checks {
            format {
                cmd "find src include -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' | xargs clang-format --dry-run --Werror"
                fix "find src include -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' | xargs clang-format -i"
            }
        }
    }

    {
        platform "python"
        files (src/**/*.py **/*.py)
        checks {
            format {
                cmd "ruff format --check ."
                fix "ruff format ."
            }
            lint {
                cmd "ruff check ."
            }
            test {
                cmd "pytest"
            }
        }
    }

    {
        platform "rust"
        files (crates/**/*.rs)
        checks {
            format {
                cmd "cargo fmt --check"
                fix "cargo fmt"
            }
        }
    }

    // The globs stop short of js/<package>/pkg and js/<package>/dist, which
    // hold build output. deno check needs no build: js/deno.json stands
    // hand-declared modules in for the generated glue.
    {
        platform "typescript"
        files (js/shared/**/*.ts js/hfst-runtime/*.ts js/hfst/*.ts js/test/**/*.ts)
        checks {
            typecheck {
                cmd "cd js && deno check"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    scope "porting"
}
