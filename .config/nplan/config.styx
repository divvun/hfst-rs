platforms (
    {
        platform "c++"
        files (src/**/*.c src/**/*.cc src/**/*.cpp src/**/*.cxx src/**/*.h src/**/*.hpp include/**/*.h include/**/*.hpp)
        checks {
            format {
                cmd "find src include -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' | xargs clang-format --dry-run --Werror"
                fix "find src include -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' | xargs clang-format -i"
            }
        }
    }

    // The binding is tested through Python, against the extension maturin
    // builds into python/.venv, as pip would install it. The tests read the
    // npm package's fixtures, which node js/test/fixtures.mjs builds, so the
    // fixture builders are inputs too. The type check runs mypy in its own
    // uvx environment: a uv sync there would uninstall the editable build.
    {
        platform "python"
        files (crates/hfst-python/** crates/hfst-embed/** python/pyproject.toml python/COPYING python/COPYING.LESSER python/divvun_hfst/** python/tests/** js/test/*fixtures.mjs)
        checks {
            test {
                cmd "cd python && uv sync --quiet --no-install-project && uv run --no-sync maturin develop --uv --quiet && uv run --no-sync pytest -q"
            }
            typecheck {
                cmd "cd python && uvx --quiet --with 'pytest>=8' --from 'mypy>=1.13' mypy"
            }
        }
    }

    {
        platform "rust"
        files (crates/**/*.rs)
        checks {
            format {
                cmd "cargo fmt --check"
                fix "cargo fmt"
            }
        }
    }

    // The globs stop short of js/hfst/pkg and js/hfst/dist, which hold build
    // output. deno check needs no build: js/deno.json stands a hand-declared
    // module in for the generated glue.
    {
        platform "typescript"
        files (js/hfst/*.ts js/test/**/*.ts)
        checks {
            typecheck {
                cmd "cd js && deno check"
            }
        }
    }
)

quality {
    // A pyo3 extension module cannot link a Rust test binary: the interpreter
    // supplies its Python symbols. python/tests tests it, under the python
    // platform's checks, and no Rust ratio can count those tests. The package
    // it builds into, python/divvun_hfst, is tested by the same pytest suite
    // in python/tests, which a directory-scoped ratio cannot see; tests
    // beside it would ship in the wheel.
    exempt-paths ("crates/hfst-python/**" "python/divvun_hfst/**")
}

commit {
    type-prefix "required"
}

adoption {
    scope "porting"
}
